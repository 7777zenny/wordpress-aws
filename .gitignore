# Terraform state (contains secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform local cache
.terraform/

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
# Keep this file so the test password is visible in the repo
!terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
